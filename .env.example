# App
APP_NAME=AICodePilot
APP_ENV=development
LOG_LEVEL=INFO

# Default LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.2

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Embedding
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Vector Store
VECTOR_STORE_BACKEND=chroma
VECTOR_STORE_PATH=./data/vector_store

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_PROJECT_PATH=/workspace
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Project path mapping for Docker
# Set PROJECTS_HOST_ROOT to the host folder that contains projects you want to inspect.
# Example: PROJECTS_HOST_ROOT=D:/code/my_projects
PROJECTS_HOST_ROOT=.
PROJECTS_CONTAINER_ROOT=/workspace

# Docker build images
# Keep defaults unchanged for normal Docker users. In restricted networks, set
# these to reachable mirrors before running docker compose build/up.
PYTHON_IMAGE=python:3.10-slim
NODE_IMAGE=node:20-alpine
